    </record>

    <!-- Stage 6: Won -->
    <record id="crm_gp_automation_stage_won" model="base.automation">
        <field name="name">crm_gp: Won stage activities</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" eval="ref('crm_gp_stage_won')"/>
