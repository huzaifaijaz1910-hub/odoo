<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Stage automations (brief section 6): dated work for the salesperson,
        created via native Automation Rules (base.automation) using the
        built-in "Create Next Activity" action - no Python needed for these.

        Scope of this file: only the activities whose due date can be
        computed purely from the moment the lead enters the stage (or is
        marked lost). The brief's per-stage tables also list activities that
        depend on something else finishing first (e.g. "48 hours after the
        survey", "3 days after sending the proposal", a recurring follow up
        every 2-3 days) or are conditional ("only if applicable"). Those need
        activity-completion triggers, not stage-entry triggers, and are
        deliberately left out of this slice rather than approximated. See
        README.md for the full list of what is deferred.

        Customer-facing emails (brief section 7) are wired to the
        mail.template records in data/mail_templates.xml via "mail_post"
        actions below - New, Technical Survey, Negotiation, Won and Lost
        send on stage entry; Qualified sends 4 hours later (see the
        separate on_time rule further down, since that needs hour
        precision the stage-entry trigger doesn't have); Proposal is
        intentionally not auto-sent (see data/mail_templates.xml). Every
        template body is still a placeholder pending approved wording -
        see that file - so this wiring wires up *when* each email fires,
        not what it says.

        Where the brief specifies hours (e.g. "24 hours", "48 hours"), the
        built-in activity action only supports day/week/month granularity,
        so these are rounded to the nearest day (24h -> 1 day, 48h -> 2
        days). "Business days" are approximated as calendar days.
    -->

    <!-- Stage 1: New -->
    <record id="crm_gp_automation_stage_new" model="base.automation">
        <field name="name">crm_gp: New stage activities</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" eval="ref('crm_gp_stage_new')"/>
    </record>
    <record id="crm_gp_action_new_contact" model="ir.actions.server">
        <field name="name">crm_gp: Contact the lead by call or WhatsApp</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_new"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_call"/>
        <field name="activity_summary">Contact the lead by call or WhatsApp</field>
        <field name="activity_note">First introduction call and confirmation of the need.</field>
        <field name="activity_date_deadline_range">1</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <record id="crm_gp_action_new_validate_contact" model="ir.actions.server">
        <field name="name">crm_gp: Validate contact details</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_new"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="activity_summary">Validate contact details</field>
        <field name="activity_note">Confirm name, phone, email and location.</field>
        <field name="activity_date_deadline_range">1</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <record id="crm_gp_action_new_apply_tags" model="ir.actions.server">
        <field name="name">crm_gp: Apply initial tags</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_new"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="activity_summary">Apply initial tags</field>
        <field name="activity_note">Priority plus customer type.</field>
        <field name="activity_date_deadline_range">0</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <record id="crm_gp_action_new_email" model="ir.actions.server">
        <field name="name">crm_gp: Send "enquiry received" email</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_new"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">mail_post</field>
        <field name="template_id" ref="crm_gp_template_new"/>
        <field name="mail_post_method">email</field>
    </record>

    <!-- Stage 2: Qualified -->
    <record id="crm_gp_automation_stage_qualified" model="base.automation">
        <field name="name">crm_gp: Qualified stage activities</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" eval="ref('crm_gp_stage_qualified')"/>
    </record>
    <record id="crm_gp_action_qualified_schedule_survey" model="ir.actions.server">
        <field name="name">crm_gp: Schedule the survey</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_qualified"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="activity_summary">Schedule the survey</field>
        <field name="activity_note">Book the on site visit, or confirm the online survey form was completed.</field>
        <field name="activity_date_deadline_range">2</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <record id="crm_gp_action_qualified_notes" model="ir.actions.server">
        <field name="name">crm_gp: Record qualification notes</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_qualified"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="activity_summary">Record qualification notes</field>
        <field name="activity_note">Need, budget, decision maker and timeline, written into the chatter.</field>
        <field name="activity_date_deadline_range">0</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <!--
        "Second phone follow up on day 3 if no reply" (brief section 6).
        "If no reply" can't be reliably detected automatically (would need
        inbound-email tracking), so this is created unconditionally as a
        day-3 reminder with a note telling the salesperson to skip it if
        the customer already replied - a harmless reminder either way,
        unlike a conditional activity that would sometimes be flatly wrong.
    -->
    <record id="crm_gp_action_qualified_second_followup" model="ir.actions.server">
        <field name="name">crm_gp: Second phone follow up</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_qualified"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_call"/>
        <field name="activity_summary">Second phone follow up</field>
        <field name="activity_note">Skip if the customer has already replied to the survey email.</field>
        <field name="activity_date_deadline_range">3</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>

    <!--
        Qualified stage email, sent 4 hours after the stage change rather
        than immediately (brief section 6). A separate rule, not another
        action on crm_gp_automation_stage_qualified, because it needs an
        hour-precision time-based trigger: crm.lead.date_last_stage_update
        is a Datetime field (unlike mail.activity.date_deadline, which is
        Date-only and caused the same problem for the escalation chain -
        see data/escalation_chain.xml), so base.automation's "on_time"
        trigger with an hour delay works correctly here without needing a
        cron.
    -->
    <record id="crm_gp_automation_qualified_email" model="base.automation">
        <field name="name">crm_gp: Qualified stage email (4h delay)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_time</field>
        <field name="trg_date_id" ref="crm.field_crm_lead__date_last_stage_update"/>
        <field name="trg_date_range">4</field>
        <field name="trg_date_range_type">hour</field>
        <field name="trg_date_range_mode">after</field>
        <field name="filter_domain" eval="&quot;[('stage_id', '=', %d)]&quot; % ref('crm_gp_stage_qualified')"/>
    </record>
    <record id="crm_gp_action_qualified_email" model="ir.actions.server">
        <field name="name">crm_gp: Send "survey options" email</field>
        <field name="base_automation_id" ref="crm_gp_automation_qualified_email"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">mail_post</field>
        <field name="template_id" ref="crm_gp_template_qualified"/>
        <field name="mail_post_method">email</field>
    </record>

    <!-- Stage 3: Technical Survey -->
    <record id="crm_gp_automation_stage_survey" model="base.automation">
        <field name="name">crm_gp: Technical Survey stage activities</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" eval="ref('crm_gp_stage_technical_survey')"/>
    </record>
    <record id="crm_gp_action_survey_carry_out" model="ir.actions.server">
        <field name="name">crm_gp: Carry out the survey</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_survey"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="crm_gp_activity_type_survey"/>
        <field name="activity_summary">Carry out the survey</field>
        <field name="activity_note">Site visit, or analysis of the submitted online form.</field>
        <field name="activity_date_deadline_range">5</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <record id="crm_gp_action_survey_email" model="ir.actions.server">
        <field name="name">crm_gp: Send "technical survey confirmed" email</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_survey"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">mail_post</field>
        <field name="template_id" ref="crm_gp_template_survey"/>
        <field name="mail_post_method">email</field>
    </record>

    <!-- Stage 4: Proposal -->
    <record id="crm_gp_automation_stage_proposal" model="base.automation">
        <field name="name">crm_gp: Proposal stage activities</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" eval="ref('crm_gp_stage_proposal')"/>
    </record>
    <record id="crm_gp_action_proposal_send" model="ir.actions.server">
        <field name="name">crm_gp: Prepare and send the proposal</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_proposal"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="crm_gp_activity_type_send_proposal"/>
        <field name="activity_summary">Prepare and send the proposal</field>
        <field name="activity_note">Quotation generated in Sales and sent from the opportunity. Valid for 15 days.</field>
        <field name="activity_date_deadline_range">3</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <!--
        The Proposal email is not auto-sent (see data/mail_templates.xml
        for why) - instead it's attached as a suggested template on the
        "Prepare and send the proposal" activity type, so it's one click
        away for the salesperson when the proposal is actually ready.
    -->
    <record id="crm_gp_activity_type_send_proposal" model="mail.activity.type">
        <field name="mail_template_ids" eval="[(4, ref('crm_gp_template_proposal'))]"/>
    </record>

    <!-- Stage 5: Negotiation -->
    <record id="crm_gp_automation_stage_negotiation" model="base.automation">
        <field name="name">crm_gp: Negotiation stage activities</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" eval="ref('crm_gp_stage_negotiation')"/>
    </record>
    <record id="crm_gp_action_negotiation_meeting" model="ir.actions.server">
        <field name="name">crm_gp: Negotiation meeting or call</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_negotiation"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="crm_gp_activity_type_negotiation_meeting"/>
        <field name="activity_summary">Negotiation meeting or call</field>
        <field name="activity_note">Discuss adjustments and the conditions for closing.</field>
        <field name="activity_date_deadline_range">2</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <record id="crm_gp_action_negotiation_email" model="ir.actions.server">
        <field name="name">crm_gp: Send "following up on proposal" email</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_negotiation"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">mail_post</field>
        <field name="template_id" ref="crm_gp_template_negotiation"/>
        <field name="mail_post_method">email</field>
    </record>

    <!-- Stage 6: Won -->
    <record id="crm_gp_automation_stage_won" model="base.automation">
        <field name="name">crm_gp: Won stage activities</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_stage_set</field>
        <field name="trg_field_ref" eval="ref('crm_gp_stage_won')"/>
    </record>
    <record id="crm_gp_action_won_contract" model="ir.actions.server">
        <field name="name">crm_gp: Prepare and send the contract</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_won"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="activity_summary">Prepare and send the contract</field>
        <field name="activity_note">Issue the contract and the deposit invoice.</field>
        <field name="activity_date_deadline_range">1</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <record id="crm_gp_action_won_schedule_install" model="ir.actions.server">
        <field name="name">crm_gp: Schedule the installation</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_won"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="activity_summary">Schedule the installation</field>
        <field name="activity_note">Coordinate the date with the customer and the technical team.</field>
        <field name="activity_date_deadline_range">5</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <record id="crm_gp_action_won_welcome_call" model="ir.actions.server">
        <field name="name">crm_gp: Welcome call</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_won"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">next_activity</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_call"/>
        <field name="activity_summary">Welcome call</field>
        <field name="activity_note">Introduce the account manager and the next steps.</field>
        <field name="activity_date_deadline_range">2</field>
        <field name="activity_date_deadline_range_type">days</field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_field_name">user_id</field>
    </record>
    <record id="crm_gp_action_won_email" model="ir.actions.server">
        <field name="name">crm_gp: Send "award confirmation" email</field>
        <field name="base_automation_id" ref="crm_gp_automation_stage_won"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">mail_post</field>
        <field name="template_id" ref="crm_gp_template_won"/>
        <field name="mail_post_method">email</field>
    </record>

    <!--
        Lost (brief section 6, "Lost via the Mark as Lost button"). Odoo's
        native lost flow already makes recording a reason mandatory, so no
        extra activity is created for that. This rule covers the 90 day
        reactivation activity, the automatic "Reactivation 90d" tag, and
        the courtesy email (placeholder body, see data/mail_templates.xml).
    -->
    <record id="crm_gp_automation_lost" model="base.automation">
        <field name="name">crm_gp: Lost follow up</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <!--
            "Mark as Lost" (action_set_lost) archives the lead first, then
            writes lost_reason_id in a separate call - so an on_archive
            trigger fires too early, before the reason is set. Watching the
            lost_reason_id field going from unset to set instead fires at
            the right time and is naturally idempotent (won't refire on
            later, unrelated writes to an already-lost lead).
        -->
        <field name="trigger">on_write</field>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('crm.field_crm_lead__lost_reason_id')])]"/>
        <field name="filter_pre_domain">[('lost_reason_id', '=', False)]</field>
        <field name="filter_domain">[('lost_reason_id', '!=', False)]</field>
    </record>
    <!--
        All three effects (tag, reactivation activity, courtesy email) are
        done in one "code" action, not the declarative "Create Next
        Activity"/"Send Email" actions, because both built-ins silently
        no-op here: action_set_lost() writes lost_reason_id together with
        probability/automated_probability in the same call, and their
        shared _is_recompute() guard (meant to stop duplicate
        activities/emails when a write is just a recompute side-effect)
        treats that combined write as one and skips running. Confirmed by
        testing: the declarative "Send Email" action silently produced no
        mail.mail here, exactly like the activity action did earlier.
        Direct activity_schedule()/template.send_mail() calls are not
        subject to that guard.
    -->
    <record id="crm_gp_action_lost_reactivation" model="ir.actions.server">
        <field name="name">crm_gp: Reactivation activity + tag + courtesy email</field>
        <field name="base_automation_id" ref="crm_gp_automation_lost"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="code">record.write({'tag_ids': [(4, env.ref('crm_gp.crm_gp_tag_reactivation_90d').id)]})
record.activity_schedule(
    activity_type_id=env.ref('mail.mail_activity_data_todo').id,
    summary='Reactivate lead',
    note='Recontact with news, a promotion or a revised proposal.',
    date_deadline=datetime.date.today() + dateutil.relativedelta.relativedelta(days=90),
)
env.ref('crm_gp.crm_gp_template_lost').send_mail(record.id, force_send=False)</field>
    </record>
</odoo>
