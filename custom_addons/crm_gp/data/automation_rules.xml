    <!--
        Lost (brief section 6, "Lost via the Mark as Lost button"). Odoo's
        native lost flow already makes recording a reason mandatory, so no
        extra activity is created for that. This rule covers the 90 day
        reactivation activity and the automatic "Reactivation 90d" tag.
        Courtesy email is not wired here (pending approved wording).
    -->
    <record id="crm_gp_automation_lost" model="base.automation">
        <field name="name">crm_gp: Lost follow up</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <!--
            "Mark as Lost" (action_set_lost) archives the lead first, then
            writes lost_reason_id in a separate call - so an on_archive
            trigger fires too early, before the reason is set. Watching the
            lost_reason_id field going from unset to set instead fires at
            the right time and is naturally idempotent (won't refire on
            later, unrelated writes to an already-lost lead).
        -->
        <field name="trigger">on_write</field>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('crm.field_crm_lead__lost_reason_id')])]"/>
        <field name="filter_pre_domain">[('lost_reason_id', '=', False)]</field>
        <field name="filter_domain">[('lost_reason_id', '!=', False)]</field>
    </record>
    <!--
        Both effects are done in one "code" action, not the declarative
        "Create Next Activity" action, because the built-in action silently
        no-ops here: action_set_lost() writes lost_reason_id together with
        probability/automated_probability in the same call, and the
        built-in action's _is_recompute() guard (meant to stop duplicate
        activities when a write is just a recompute side-effect) treats
        that combined write as one and skips creating the activity. Direct
        activity_schedule() is not subject to that guard.
    -->
    <record id="crm_gp_action_lost_reactivation" model="ir.actions.server">
        <field name="name">crm_gp: Reactivation activity + tag</field>
        <field name="base_automation_id" ref="crm_gp_automation_lost"/>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="usage">base_automation</field>
        <field name="state">code</field>
        <field name="code">record.write({'tag_ids': [(4, env.ref('crm_gp.crm_gp_tag_reactivation_90d').id)]})
record.activity_schedule(
    activity_type_id=env.ref('mail.mail_activity_data_todo').id,
    summary='Reactivate lead',
    note='Recontact with news, a promotion or a revised proposal.',
    date_deadline=datetime.date.today() + dateutil.relativedelta.relativedelta(days=90),
)</field>
    </record>
</odoo>
